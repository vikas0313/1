# Phase 2 Production environment variables example

# Backend Data Layer Switch ('local' | 'supabase')
VITE_DATA_BACKEND=supabase

# Supabase Project Configuration (Required when VITE_DATA_BACKEND=supabase)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Base Frontend Site URL
VITE_BASE_URL=https://your-domain.com

# NOTE: VITE_DEMO_OWNER_PASSWORD is strictly for local dev prototype mode.
# In production (supabase backend), owner authentication is handled via Supabase Auth
# and the demo password is automatically disabled and removed.
