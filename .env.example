# ─── Ritsu Food Corner Environment Variables ───

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_PATH=./data/ritsu.db

# Auth
SESSION_SECRET=change-me-to-a-long-random-string
OWNER_PASSWORD_HASH=$2a$10$someGeneratedBcryptHashHere

# Demo Mode — set to false in production
DEMO_MODE=true

# Public base URL for QR codes (must be reachable from customer phones)
BASE_URL=http://localhost:3001
