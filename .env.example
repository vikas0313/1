# Ritsu Food Corner - Environment Configuration Example

# Server Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port and Host
PORT=3001
HOST=0.0.0.0

# Database Storage Location (Persistent disk path in production, e.g. /data/ritsu.db)
DATABASE_PATH=./data/ritsu.db

# Owner Session Secret (64-char random hex string in production: openssl rand -hex 32)
SESSION_SECRET=ritsu-change-this-secret-in-production-min-32-chars

# Owner Dashboard Password Hash (Generate using: npm run hash-password)
OWNER_PASSWORD_HASH=""

# Demo Mode ('true' for local testing where 'admin123' works, 'false' in production)
DEMO_MODE=true

# Public Base URL of the application
BASE_URL=http://localhost:5173

# Allowed Origins for CORS (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Restaurant Details
RESTAURANT_NAME="Ritsu Food Corner"
RESTAURANT_TAGLINE="Indo-Chinese ka asli maza – Ristsu ke saath!"
RESTAURANT_PHONE="+91 98765 43210"
RESTAURANT_ADDRESS="Main Road, Food Street, Hyderabad"
UPI_VPA="ritsu@upi"
GSTIN="36ABCDE1234F1Z5"
